<?php if(!$this->invisible): ?>


    <?php
        $page = '';
        if(str_contains($_SERVER['REQUEST_URI'], 'shop-list')){
            $page = 'list';
        } elseif(str_contains($_SERVER['REQUEST_URI'], 'shop-detail')){
            $page = 'detail';
            $itemId = $_GET['id'];
        } elseif(str_contains($_SERVER['REQUEST_URI'], 'warenkorb')){
            $page = 'basket';
        }
    ?>

    <?php if($page === 'list'): ?>
    <a class="shop-item list" href="{{link_url::117}}?id=<?= $this->id ?>">
        <div class="list-image-wrapper"><div class="list-image" style="background:url('/{{file::<?= $this->images[0]->image ?>}}') center center/cover"></div></div>
        <h3><?= $this->name ?></h3>
        <p><?= $this->shortDescription ?></p>
        <p class="price"><?= str_replace('.', ',', number_format(floatval(str_replace(',', '.', $this->price)), 2)) ?> €</p>
    </a>

    <?php elseif($page === 'detail'): ?>
        <?php if($this->id === intval($itemId)): ?>
        <div class="shop-item detail">
            <div class="hero-image">
                <?php if(count($this->images) === 1): ?>
                    <img src="/{{file::<?= $this->images[0]->image ?>}}">
            <?php elseif(count($this->images) > 1): ?>
                    <div class="content-swiper">
                        <div class="swiper swiper-initialized swiper-horizontal swiper-backface-hidden" data-delay="0" data-speed="300" data-offset="0">
                            <div class="swiper-wrapper" id="swiper-wrapper-80ae6c261082d83c9" aria-live="polite">
                                <?php foreach($this->images as $image): ?>
                                    <div class="swiper-slide" role="group">
                                        <div class="content-image">
                                            <figure>
                                                <img src="/{{file::<?= $image->image ?>}}" alt="">
                                            </figure>
                                        </div>
                                    </div>
                                <?php endforeach; ?>
                            </div>
                            <button type="button" class="swiper-button-prev swiper-button-disabled" disabled="" tabindex="-1" aria-label="Previous slide" aria-controls="swiper-wrapper-80ae6c261082d83c9" aria-disabled="true"></button>
                            <button type="button" class="swiper-button-next" tabindex="0" aria-label="Next slide" aria-controls="swiper-wrapper-80ae6c261082d83c9" aria-disabled="false"></button>
                            <div class="swiper-pagination swiper-pagination-clickable swiper-pagination-bullets swiper-pagination-horizontal"><span class="swiper-pagination-bullet swiper-pagination-bullet-active" tabindex="0" role="button" aria-label="Go to slide 1" aria-current="true"></span><span class="swiper-pagination-bullet" tabindex="0" role="button" aria-label="Go to slide 2"></span><span class="swiper-pagination-bullet" tabindex="0" role="button" aria-label="Go to slide 3"></span></div>
                            <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>
                    </div>
            <?php endif; ?>
            </div>
            <div class="description">
                <h1><?= $this->name ?></h1>
                <?= $this->longDescription ?>
                <p class="price"><?= str_replace('.', ',', number_format(floatval(str_replace(',', '.', $this->price)), 2)) ?> €</p>
            </div>
            <p><a class="add-to-basket-button shop-button" data-id="<?= $this->id ?>">
                Zum Warenkorb hinzufügen
            </a></p>
            <p><a class="shop-button" href="{{link_url::116}}">Weiter shoppen</a></p>
            {{file::current-basket-info.php}}
        </div>
    <?php endif; ?>
    <?php elseif($page === 'basket'): ?>
        <div class="shop-item basket" id="<?= $this->id ?>">
            <div class="list-image-wrapper">
                <img src="/{{file::<?= $this->images[0]->image ?>}}">
            </div>
            <div class="basket-item-info">
                <h3><?= $this->name ?></h3>
                <p><?= $this->shortDescription ?></p>
                <p class="price">Einzelpreis EUR: <span data-price="<?= floatval(str_replace(',', '.', $this->price)) ?>"><?= str_replace('.', ',', number_format(floatval(str_replace(',', '.', $this->price)), 2)) ?></span></p>
                <p class="amount">Stückzahl: <a class="increase-amount"><img src="/files/assets/layout/iconmonstr-plus-circle-thin.svg"></a><span></span><a class="decrease-amount"><img src="/files/assets/layout/iconmonstr-minus-circle-thin.svg"></a></p>
                <p class="sum">Gesamt EUR: <span></span></p>
                <p class="remove"><a>Aus dem Warenkorb entfernen</a></p>
            </div>
        </div>
    <?php endif; ?>

<?php endif; ?>
