<?php if(!$this->invisible): ?>


    <?php
        $page = '';
        if(str_contains($_SERVER['REQUEST_URI'], 'shop-list')){
            $page = 'list';
        } elseif(str_contains($_SERVER['REQUEST_URI'], 'shop-detail')){
            $page = 'detail';
            $itemId = $_GET['id'];
        } elseif(str_contains($_SERVER['REQUEST_URI'], 'warenkorb')){
            $page = 'basket';
        }
    ?>

    <?php if($page === 'list'): ?>
    <a class="shop-item list" href="{{link_url::117}}?id=<?= $this->id ?>">
        <div class="list-image-wrapper"><div class="list-image" style="background:url('/{{file::<?= $this->images[0]->image ?>}}') center center/cover"></div></div>
        <h3><?= $this->name ?></h3>
        <p><?= $this->shortDescription ?></p>
        <p class="price"><?= str_replace('.', ',', number_format(floatval(str_replace(',', '.', $this->price)), 2)) ?> €</p>
    </a>

    <?php elseif($page === 'detail'): ?>
        <?php if($this->id === intval($itemId)): ?>
        <div class="shop-item detail">
            <div class="shop-item-detail-left"><div class="hero-image">
                    <?php if(count($this->images) === 1): ?>
                        <img src="/{{file::<?= $this->images[0]->image ?>}}">
                    <?php elseif(count($this->images) > 1): ?>
                        <div class="ce_sliderStart block">
                            <div class="content-slider" data-config="0,1000,0,1" style="visibility: visible;">
                                <div class="slider-wrapper">
                                    <?php foreach($this->images as $image): ?>
                                        <div class="ce_image">
                                            <figure>
                                                <img src="/{{file::<?= $image->image ?>}}">
                                            </figure>
                                        </div>
                                    <?php endforeach; ?>
                                </div>
                            </div>
                            <nav class="slider-control">
                                <a href="#" class="slider-prev"><img src="/files/SMG/img/Vektorgrafiken/arrleft1.png"></a>
                                <a href="#" class="slider-next"><img src="/files/SMG/img/Vektorgrafiken/arrright1.png"></a>
                            </nav>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
            <div class="shop-item-detail-right"><div class="description">
                    <h1><?= $this->name ?></h1>
                    <?= $this->longDescription ?>
                    <p class="price"><?= str_replace('.', ',', number_format(floatval(str_replace(',', '.', $this->price)), 2)) ?> €</p>
                </div>
                <p><a class="add-to-basket-button shop-button" data-id="<?= $this->id ?>">
                        Zum Warenkorb hinzufügen
                    </a></p>
                <p><a class="shop-button" href="{{link_url::116}}">Weiter shoppen</a></p>
                {{file::current-basket-info.php}}
            </div>
        </div>
    <?php endif; ?>
    <?php elseif($page === 'basket'): ?>
        <div class="shop-item basket" id="<?= $this->id ?>">
            <div class="list-image-wrapper">
                <img src="/{{file::<?= $this->images[0]->image ?>}}">
            </div>
            <div class="basket-item-info">
                <h3><?= $this->name ?></h3>
                <p><?= $this->shortDescription ?></p>
                <p class="price">Einzelpreis EUR: <span data-price="<?= floatval(str_replace(',', '.', $this->price)) ?>"><?= str_replace('.', ',', number_format(floatval(str_replace(',', '.', $this->price)), 2)) ?></span></p>
                <p class="amount">Stückzahl: <a class="increase-amount"><img src="/files/assets/layout/iconmonstr-plus-circle-thin.svg"></a><span></span><a class="decrease-amount"><img src="/files/assets/layout/iconmonstr-minus-circle-thin.svg"></a></p>
                <p class="sum">Gesamt EUR: <span></span></p>
                <p class="remove"><a>Aus dem Warenkorb entfernen</a></p>
            </div>
        </div>
    <?php endif; ?>

<?php endif; ?>
